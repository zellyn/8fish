; Generated by cmd/genrwts. DO NOT EDIT.
; The TRANSIENT ProRWTS2 write-capable floppy driver (docs/prorwts2-design.md
; Feature 2, docs/saveload-feasibility.md): loaded ON DEMAND from the RWTSW
; disk file into dead engine scratch at main $0E00 by the save command,
; materialized (slot pokes + trackd1 seed), run once to overwrite the SAVE
; file's blocks in place, and discarded. Nothing write-capable is resident.

RWTSW_ENTRY   = $0E00   ; opendir: open the named file, then read/write per REQCMD
RWTSW_SIZE    = 1024   ; blob bytes ($0E00-$11FF), incl. prebuilt tables + site lists
RWTSW_CODE    = 692    ; of which code
RWTSW_TRACKD1 = $0F9D   ; current-track operand (seed from the RESIDENT driver's)
RWTSW_DIRBUF  = $1200   ; 512-byte directory/index scratch, MAIN
RWTSW_ENCBUF  = $1400   ; 512-byte write nibblize scratch, MAIN (NOT dirbuf)
RWTSW_NSLOT   = 10     ; soft-switch operand addresses (ORA the slot into the lo byte):
RWTSW_SLOTLO  = $10B4   ; their lo bytes...
RWTSW_SLOTHI  = $10BE   ; ...and hi bytes
RWTSW_NIMM    = 4      ; raw slot<<4 IMMEDIATE operands (STORE the slot):
RWTSW_IMMLO   = $10C8   ; their lo bytes...
RWTSW_IMMHI   = $10CC   ; ...and hi bytes
; zero-page API: same $3C-$67 window as the resident driver (rwtszp serves
; both), same STATUS/SIZELO/LDRLO/NAMLO bytes, PLUS the command byte —
; there is NO auxreq in this build ($51 is unused; the write is main-only).
RWTSW_REQCMD  = $54     ; 1 = read, 2 = write (set before every call)
RWTSW_CMDWRITE = 2      ; the write command

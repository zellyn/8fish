; Generated by cmd/genbook. DO NOT EDIT.
; Resident opening book layout. The book is delivered in TWO pieces by
; the SECOND stage of the disk's chain load, and the copier in asm/m8.s
; puts each where it stays:
;
;   ENTRIES (header + sorted entry array) -> AUXILIARY RAM $0800.
;     Above the 80-column text page's aux half at $0400-$07FF, which is
;     what the mixed-mode text window's EVEN columns come from -- that is
;     the whole reason the base is $0800 and not $0200.
;   NAME TABLE -> LANGUAGE CARD BANK 2 $D000.
;     bookprobe NEVER reads it. Only asm/m8.s's uibookname does, and that
;     runs at $E000, which LC bank switching does not touch.
;
; Probe: compute HASH0-3 for the current position, binary-search the
; sorted entry array on the 4-byte key, weighted-pick among equal-key
; entries, then NAMEID -> current-opening byte.

BOOK_BASE      = $0800   ; resident base address (AUX)
BOOK_MAGIC     = BOOK_BASE+0   ; 2 bytes 'B','K'
BOOK_COUNT     = BOOK_BASE+2   ; word: entry count (633)
BOOK_NAMEADDR  = BOOK_BASE+4   ; word: the name table's ABSOLUTE
                               ;  resident address ($D000, LC bank 2)
BOOK_NAMECT    = BOOK_BASE+6   ; byte: name count (80)
BOOK_STRIDE    = 9            ; entry stride in bytes
BOOK_ENTRIES   = BOOK_BASE+8   ; first entry
BOOK_NAMES     = $D000   ; the name table's resident base (LC bank 2)
BIGBOOK_BASE   = $4000   ; the BIG BOOK's aux home: the idle TT window
BIGBOOK_WIN    = $8000   ; the window's size; checksum trailer in its last 2 bytes
BIGBOOK_MAX    = 3639    ; its capacity in entries (checksum trailer priced in)

; entry field offsets (from an entry base):
BOOK_E_KEY     = 0    ; 4 bytes LE == HASH0..3
BOOK_E_FROM    = 4    ; 0x88 from-square
BOOK_E_TO      = 5    ; 0x88 to-square
BOOK_E_FLAGS   = 6    ; move flags (bits 0-2 promo)
BOOK_E_WEIGHT  = 7    ; weighted-pick weight
BOOK_E_NAMEID  = 8    ; name-table index -> current-opening byte

; build stats:
BOOK_ENTRY_COUNT = 633
BOOK_NAME_COUNT  = 80
BOOK_BLOB_SIZE   = 5705
BOOK_NAMES_SIZE  = 1702
